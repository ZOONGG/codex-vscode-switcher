<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>CodexVsCodeSwitcher</AssemblyName>
    <RootNamespace>CodexVsCodeSwitcher</RootNamespace>
    <Product>Codex VS Code Switcher</Product>
    <Description>Switch between isolated Codex profiles in a dedicated Visual Studio Code environment.</Description>
    <Company>ZOONGG</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexVsCodeSwitcher.Core\CodexVsCodeSwitcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\CodexVsCodeSwitcher.Companion\package.json">
      <Link>companion-extension\package.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\CodexVsCodeSwitcher.Companion\extension.js">
      <Link>companion-extension\extension.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\CodexVsCodeSwitcher.Companion\companion-core.js">
      <Link>companion-extension\companion-core.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
